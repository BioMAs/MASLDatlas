# Backend Environment Configuration for MASLDatlas
# Copy this file to .env and customize for your deployment

# Application Environment
ENVIRONMENT=production
DEBUG=false

# CORS Configuration
# IMPORTANT: Add your Vercel frontend URL here to allow API access from Vercel deployment
# Example: ALLOWED_ORIGINS=https://masldatlas.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Dataset Configuration
CONFIG_PATH=/app/config/datasets_config.json

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=3600

# Performance Settings
MAX_CELLS_DISPLAY=100000
MAX_GENES_DISPLAY=50000
N_JOBS=-1

# Redis Configuration (if using Redis service)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0

# Resource Limits (for production deployment)
MEMORY_LIMIT=4G
CPU_LIMIT=2.0
CACHE_VOLUME=masldatlas_cache
LOGS_VOLUME=masldatlas_logs

# Backup Configuration (for future use)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Monitoring Configuration (for future use)
MONITORING_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
